# web-access 用户生产配置模板
# check-deps.mjs 首次运行时会在 %LOCALAPPDATA%\web-access\config.env 原子创建等价配置。
# 源码、CC Switch、Claude、Codex 的技能副本都读取该唯一文件，不读取各自目录下的 config.env。
#
# 用户长期偏好的默认 Agent 浏览器。未显式指定时默认使用 Edge。
# 若默认浏览器未检测到 remote debugging toggle，则硬错（不擅自降级）。
#
# 合法值：chrome / edge
WEB_ACCESS_BROWSER=edge

# 浏览器接入模式：
# existing = 连接当前已运行且开启 remote debugging 的 Edge，复用本机现有登录态
# managed  = 显式选择隔离的 Edge Profile；不会作为 existing 的自动回退。
# Windows 默认 existing。
WEB_ACCESS_BROWSER_MODE=existing

# 生产端口固定，避免不同技能副本同时连接同一浏览器而重复触发远程调试授权。
# 不得改成备用端口；临时端口仅允许隔离测试模式使用。
WEB_ACCESS_EDGE_PORT=3456
WEB_ACCESS_CHROME_PORT=3457
